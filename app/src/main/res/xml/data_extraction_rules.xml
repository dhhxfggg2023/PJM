<?xml version="1.0" encoding="utf-8"?><!--
  API 31+ 的数据提取规则（由 android:dataExtractionRules 引用）。

  注意：`android:allowBackup="false"` 在 Android 12+ 上并不能单独阻止
  「设备到设备迁移」读取应用数据，必须在这里同样排除敏感目录。
  参见 https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pjm_vault/" />
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="file" path="image_fingerprints/" />
        <exclude domain="file" path="backups/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="pjm_named_share/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pjm_vault/" />
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="file" path="image_fingerprints/" />
        <exclude domain="file" path="backups/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="pjm_named_share/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
