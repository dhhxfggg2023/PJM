<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 只暴露确有分享需求的三类私有目录，不再把整个 filesDir 交给 FileProvider -->
    <files-path name="vault" path="pjm_vault/" />
    <files-path name="logs" path="logs/" />

    <!-- 应用缓存目录（规范名分享副本、更新包、解压临时索引都落在这里） -->
    <cache-path name="cache_root" path="." />

    <!-- 外部私有目录（仅 getExternalFilesDir()，不是整个 /sdcard） -->
    <external-files-path name="external_files" path="." />
</paths>
