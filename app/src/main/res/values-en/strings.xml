    <string name="takeover_status_battery_ok">Battery optimization: allowed</string>
    <string name="takeover_status_battery_off">Battery optimization: not allowed (tap “Allow background running” below)</string>
    <string name="takeover_status_no_scan">Background scan: no records yet</string>
